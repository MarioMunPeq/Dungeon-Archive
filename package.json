{
  "name": "dungeon-archive",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check": "pnpm typecheck && pnpm lint",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"scripts/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\" \"scripts/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.scripts.json",
    "build:compendium": "tsx scripts/compendium/build.ts",
    "test:identity": "tsx scripts/tests/identity.test.ts",
    "test:grouping": "tsx scripts/tests/grouping.test.ts",
    "test:resolver": "tsx scripts/tests/resolver.test.ts",
    "test:compendium": "tsx scripts/tests/compendium.test.ts",
    "test:category": "tsx scripts/tests/category.test.ts",
    "test:highlight": "tsx scripts/tests/highlight.test.ts",
    "test:navigation": "tsx --tsconfig tsconfig.app.json scripts/tests/navigation.test.ts",
    "test:content": "tsx scripts/tests/content.test.ts",
    "test:design": "tsx --tsconfig tsconfig.app.json scripts/tests/design-system.test.tsx",
    "test:relationships": "tsx scripts/tests/relationships.test.ts",
    "test:magic-item": "tsx scripts/tests/magic-item.test.ts",
    "test:feat": "tsx scripts/tests/feat.test.ts",
    "test:user-state": "tsx scripts/tests/user-state.test.ts",
    "test:sync": "tsx scripts/tests/sync.test.ts",
    "test:firebase-config": "tsx scripts/tests/firebase-config.test.ts",
    "test:firebase-adapter": "tsx scripts/tests/firebase-adapter.test.ts",
    "test": "pnpm run test:identity && pnpm run test:grouping && pnpm run test:resolver && pnpm run test:compendium && pnpm run test:category && pnpm run test:highlight && pnpm run test:navigation && pnpm run test:content && pnpm run test:design && pnpm run test:relationships && pnpm run test:magic-item && pnpm run test:feat && pnpm run test:user-state && pnpm run test:sync && pnpm run test:firebase-config && pnpm run test:firebase-adapter"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "clsx": "^2.1.1",
    "firebase": "^12.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.21",
    "globals": "^16.2.0",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.38.0",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0"
  }
}
