{
  "name": "dungeon-archive",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"scripts/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\" \"scripts/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.scripts.json",
    "build:compendium": "tsx scripts/compendium/build.ts",
    "test:identity": "tsx scripts/tests/identity.test.ts",
    "test:grouping": "tsx scripts/tests/grouping.test.ts",
    "test:resolver": "tsx scripts/tests/resolver.test.ts",
    "test:compendium": "tsx scripts/tests/compendium.test.ts",
    "test:category": "tsx scripts/tests/category.test.ts",
    "test": "npm run test:identity && npm run test:grouping && npm run test:resolver && npm run test:compendium && npm run test:category"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.84.0",
    "clsx": "^2.1.1",
    "dexie": "^4.0.11",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^7.7.1",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.21",
    "globals": "^16.2.0",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.38.0",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0"
  }
}
